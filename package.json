{
  "name": "sonora-vercel-music",
  "version": "1.1.0",
  "private": true,
  "description": "Personal music library deployed to Vercel with Vercel Blob direct client upload.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js",
    "build": "esbuild src/app.js --bundle --minify --format=iife --platform=browser --target=es2022 --outfile=public/app.bundle.js",
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node --check server.js && node --check src/app.js"
  },
  "engines": {"node": ">=20"},
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "dotenv": "^16.6.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
