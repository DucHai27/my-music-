# For Vercel Dashboard -> Project -> Settings -> Environment Variables:
APP_PASSWORD=choose-at-least-12-characters
SESSION_SECRET=at-least-32-random-characters
# Created automatically when connecting Vercel Blob Storage to your project:
BLOB_READ_WRITE_TOKEN=vercel_blob_token_here
# Optional: maximum file size (MB). Default 150.
MAX_UPLOAD_MB=150
